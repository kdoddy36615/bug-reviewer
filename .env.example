# ─── Azure DevOps ───────────────────────────────────────────────────────────
# Your ADO organization and project. Set these as az CLI defaults too:
#   az devops configure --defaults organization=$AZURE_ORG project=$AZURE_PROJECT
AZURE_ORG=https://dev.azure.com/<YOUR_AZURE_ORG>
AZURE_PROJECT=<YOUR_AZURE_PROJECT>

# The person doing the bug work (you). Each developer fills in their own values.
AZURE_ASSIGNEE_EMAIL=<YOUR_ASSIGNEE_EMAIL>
AZURE_ASSIGNEE_ID=<YOUR_ASSIGNEE_GUID>          # find with: az devops user show --user <email>

# Saved query GUID for "new bugs to triage". Create the query in ADO and copy
# the GUID from the URL. The orchestrator polls this query at the start of each session.
ADO_BUGS_QUERY_ID=<YOUR_ADO_BUGS_QUERY_ID>

# ─── Target repository ──────────────────────────────────────────────────────
# Absolute path to the codebase you're fixing bugs in.
TARGET_REPO_PATH=/Users/<you>/projects/<your-repo>

# Command that starts your local dev server (whatever serves the preview URL below).
# Examples: "pnpm dev", "npm run dev", "vite", "next dev", "pnpm dev:<app>"
DEV_COMMAND=<YOUR_DEV_COMMAND>

# Base URL where the dev server is reachable. Used by the screenshot capture step.
PREVIEW_BASE_URL=https://localhost:3000

# ─── Storyblok (optional — only if you use Storyblok) ───────────────────────
STORYBLOK_SPACE_ID=<YOUR_STORYBLOK_SPACE_ID>
STORYBLOK_BUGS_FOLDER_ID=<YOUR_STORYBLOK_BUGS_FOLDER_ID>   # ID of the folder where bug-fix stories are created
STORYBLOK_MANAGEMENT_TOKEN=                     # Account → Settings → Access Tokens (Management API)
STORYBLOK_PREVIEW_TOKEN=                        # Space → Settings → Access Tokens (Preview)

# Draft-mode secret used by your preview server (e.g. NEXTAUTH_SECRET, DRAFT_SECRET, etc.)
DRAFT_SECRET_TOKEN=

# ─── Reviewers (PR creation) ────────────────────────────────────────────────
# Email of the required reviewer (set as required at PR creation time).
YOUR_REQUIRED_REVIEWER_EMAIL=
# Optional additional reviewers (added but not required).
YOUR_REVIEWER_1_EMAIL=
YOUR_REVIEWER_2_EMAIL=

# ─── Bug Reviewer UI ────────────────────────────────────────────────────────
BUG_REVIEWER_PORT=3737

# ─── Figma MCP server (optional) ────────────────────────────────────────────
# Only needed if you want the agent to fetch design specs from Figma during fixes.
FIGMA_API_KEY=                                  # Figma → Account → Settings → Personal access tokens
FIGMA_DEFAULT_FILE_KEY=<YOUR_FIGMA_FILE_KEY>    # The Figma file the agent should default to
